  "finalFaqs": {
    "heading": "Arkansas Lottery \u2014 Frequently Asked Questions",
    "visibleOnPage": true,
    "items": [
      {
        "q": "What time are Arkansas Lottery drawings held?",
        "a": "Draw times vary by game; times on this page use Arkansas local time. See the Schedule section for each game's days and times."
      },
      {
        "q": "What is the minimum age to play the Arkansas Lottery?",
        "a": "You must be 18 or older to play."
      },
      {
        "q": "Are Arkansas Lottery prizes taxed?",
        "a": "Arkansas withholds state income tax on lottery winnings, in addition to federal tax. Federal withholding of 24% applies to prizes over $5,000."
      },
      {
        "q": "How do I claim a Arkansas Lottery prize?",
        "a": "Smaller prizes can be claimed at retailers; larger prizes at a Lottery office or headquarters. See How to Claim above."
      },
      {
        "q": "What happens to unclaimed Arkansas Lottery prizes?",
        "a": "Unclaimed prize funds are directed to state programs per Arkansas Lottery rules."
      }
    ]
  },
