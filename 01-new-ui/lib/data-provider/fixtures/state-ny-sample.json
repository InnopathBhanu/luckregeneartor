  "finalFaqs": {
    "heading": "New York Lottery \u2014 Frequently Asked Questions",
    "visibleOnPage": true,
    "items": [
      {
        "q": "What time are New York Lottery drawings held?",
        "a": "Draw times vary by game; times on this page use New York local time. See the Schedule section for each game's days and times."
      },
      {
        "q": "What is the minimum age to play the New York Lottery?",
        "a": "You must be 18 or older to play."
      },
      {
        "q": "Are New York Lottery prizes taxed?",
        "a": "New York withholds state income tax on lottery winnings, in addition to federal tax. Federal withholding of 24% applies to prizes over $5,000."
      },
      {
        "q": "How do I claim a New York Lottery prize?",
        "a": "Smaller prizes can be claimed at retailers; larger prizes at a Lottery office or headquarters. See How to Claim above."
      },
      {
        "q": "What happens to unclaimed New York Lottery prizes?",
        "a": "Unclaimed prize funds are directed to state programs per New York Lottery rules."
      }
    ]
  },
