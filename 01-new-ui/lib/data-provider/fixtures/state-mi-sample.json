  "finalFaqs": {
    "heading": "Michigan Lottery \u2014 Frequently Asked Questions",
    "visibleOnPage": true,
    "items": [
      {
        "q": "What time are Michigan Lottery drawings held?",
        "a": "Draw times vary by game; times on this page use Michigan local time. See the Schedule section for each game's days and times."
      },
      {
        "q": "What is the minimum age to play the Michigan Lottery?",
        "a": "You must be 18 or older to play."
      },
      {
        "q": "Are Michigan Lottery prizes taxed?",
        "a": "Michigan withholds state income tax on lottery winnings, in addition to federal tax. Federal withholding of 24% applies to prizes over $5,000."
      },
      {
        "q": "How do I claim a Michigan Lottery prize?",
        "a": "Smaller prizes can be claimed at retailers; larger prizes at a Lottery office or headquarters. See How to Claim above."
      },
      {
        "q": "What happens to unclaimed Michigan Lottery prizes?",
        "a": "Unclaimed prize funds are directed to state programs per Michigan Lottery rules."
      }
    ]
  },
