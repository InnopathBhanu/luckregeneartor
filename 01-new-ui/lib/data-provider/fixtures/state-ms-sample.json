  "finalFaqs": {
    "heading": "Mississippi Lottery \u2014 Frequently Asked Questions",
    "visibleOnPage": true,
    "items": [
      {
        "q": "What time are Mississippi Lottery drawings held?",
        "a": "Draw times vary by game; times on this page use Mississippi local time (CT). See the Schedule section."
      },
      {
        "q": "What is the minimum age to play the Mississippi Lottery?",
        "a": "You must be 18 or older to play."
      },
      {
        "q": "Are Mississippi Lottery prizes taxed?",
        "a": "Mississippi withholds state income tax on lottery winnings, in addition to federal tax. Federal withholding of 24% applies to prizes over $5,000."
      },
      {
        "q": "How do I claim a Mississippi Lottery prize?",
        "a": "Smaller prizes at retailers; larger prizes at a claim center or headquarters. See How to Claim above."
      },
      {
        "q": "What happens to unclaimed Mississippi Lottery prizes?",
        "a": "Unclaimed prize funds are directed to state programs per Mississippi Lottery rules."
      }
    ]
  },
